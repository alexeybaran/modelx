From c5fc914c073e70de0237b09e42667957e670abf4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 03:17:41 +0000
Subject: [PATCH 1/3] Save References to classes defined in user modules

A class defined in a module created by new_module cannot be pickled by
reference, because the module is loaded from the model folder and is
not importable, so saving a model with a Reference to such a class
failed with PicklingError.

The model pickler now emits ("ModuleAttr", spec id, class name) for
any top-level class of a ModuleData module, wherever the class occurs
in data.pickle, and the unpickler takes the class from the module the
reader has just loaded from the model folder. A copy of the model thus
needs nothing but its own folder, and edits to its module file take
effect on reading. Models without such classes are pickled exactly as
before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019ikg7NJaGw75uaSPfLFj8d
---
 modelx/io/moduleio.py                       | 22 +++++
 modelx/serialize/custom_pickle.py           | 10 +++
 modelx/tests/serialize/test_serializer_8.py | 93 +++++++++++++++++++++
 3 files changed, 125 insertions(+)

diff --git a/modelx/io/moduleio.py b/modelx/io/moduleio.py
index 2d0024e..b7b9a07 100644
--- a/modelx/io/moduleio.py
+++ b/modelx/io/moduleio.py
@@ -136,3 +136,25 @@ class ModuleData(BaseIOSpec):
 
     def __repr__(self):
         return "<ModuleData path=%s>" % repr(str(self._io.path.as_posix()))
+
+
+def module_classes(specs):
+    """Map the classes defined in user modules to their modules
+
+    Returns a dict mapping the id of each class defined at the top level
+    of the module held by a :class:`ModuleData` in ``specs`` to a tuple
+    of the :class:`ModuleData` and the class name. Such a class cannot be
+    pickled by reference, as its module is not importable, so picklers
+    refer to it by the spec and the name instead.
+    """
+    result = {}
+    for spec in specs:
+        module = spec.value if isinstance(spec, ModuleData) else None
+        if module is None:
+            continue
+        for name, value in vars(module).items():
+            if (isinstance(value, type)
+                    and value.__module__ == module.__name__
+                    and value.__qualname__ == name):
+                result.setdefault(id(value), (spec, name))
+    return result
diff --git a/modelx/serialize/custom_pickle.py b/modelx/serialize/custom_pickle.py
index 21f926b..a55b74c 100644
--- a/modelx/serialize/custom_pickle.py
+++ b/modelx/serialize/custom_pickle.py
@@ -3,6 +3,7 @@ import pathlib
 from modelx.core.system import mxsys
 from modelx.core.base import NullImpl, null_impl
 from modelx.io.baseio import BaseSharedIO, IOManager, BaseIOSpec
+from modelx.io.moduleio import module_classes
 from modelx.core.node import BaseNode, ObjectNode, get_node, ItemNode, OBJ, KEY
 from . import ziputil
 
@@ -82,6 +83,7 @@ class ModelPickler(pickle.Pickler):
     def __init__(self, file, writer):
         super().__init__(file)
         self.writer = writer
+        self.module_classes = module_classes(writer.model.iospecs)
 
     def spec_id(self, obj):
         # The id emitted for a BaseIOSpec must match a key of the
@@ -100,6 +102,10 @@ class ModelPickler(pickle.Pickler):
         data_value_id = self.data_value_id(obj)
         if data_value_id is not None:
             return "DataValue", data_value_id
+        elif id(obj) in self.module_classes:
+            # A class defined in a user module (new_module)
+            spec, name = self.module_classes[id(obj)]
+            return "ModuleAttr", self.spec_id(spec), name
         elif isinstance(obj, BaseIOSpec):
             return "BaseIOSpec", self.spec_id(obj)
         elif isinstance(obj, BaseSharedIO):
@@ -177,6 +183,10 @@ class ModelUnpickler(pickle.Unpickler):
             _, sp_id = pid
             return self._find_iospec(sp_id).value
 
+        elif pid[0] == "ModuleAttr":
+            _, sp_id, name = pid
+            return getattr(self._find_iospec(sp_id).value, name)
+
         elif pid[0] in ("BaseIOSpec", "BaseDataSpec"):  # renamed in v0.20
             _, sp_id = pid
             return self._find_iospec(sp_id)
diff --git a/modelx/tests/serialize/test_serializer_8.py b/modelx/tests/serialize/test_serializer_8.py
index c9ec73c..7ee63e7 100644
--- a/modelx/tests/serialize/test_serializer_8.py
+++ b/modelx/tests/serialize/test_serializer_8.py
@@ -240,6 +240,99 @@ def test_module_roundtrip(tmp_path, close_new_models):
     assert entries == [(1, "ModuleData", 1, "modules/foo", {}, {})]
 
 
+LABELS_SOURCE = """\
+from enum import IntEnum
+
+
+class Plan(IntEnum):
+    T10 = 0
+    T20 = 1
+
+
+class Basis:
+    rate = 0.01
+"""
+
+
+def _make_module_class_model(tmp_path):
+    src = tmp_path / "labels_src.py"
+    src.write_text(LABELS_SOURCE, encoding="utf-8")
+    m = mx.new_model("V8ModuleClass")
+    s = m.new_space("Space1")
+    m.new_module(name="labels", path="labels.py", module=src)
+    s.Plan = m.labels.Plan
+    s.Basis = m.labels.Basis
+    s.terms = {m.labels.Plan.T10: 10, m.labels.Plan.T20: 20}
+    s.new_cells("term", formula=lambda p: terms[p])
+    s.new_cells("t10", formula=lambda: term(Plan.T10))
+    return m
+
+
+@pytest.mark.parametrize("save_meth", ["write", "zip"])
+def test_module_class_ref_roundtrip(tmp_path, close_new_models, save_meth):
+    """A Reference to a class defined in a user module (new_module) is
+    pickled by the module's spec and the class name, and restored from
+    the module the model loads."""
+    m = _make_module_class_model(tmp_path)
+    assert m.Space1.t10() == 10
+
+    path = tmp_path / "model"
+    getattr(m, save_meth)(path)
+    m.close()
+
+    m2 = mx.read_model(path)
+    s2 = m2.Space1
+    assert s2.Plan is m2.labels.Plan
+    assert s2.Basis is m2.labels.Basis
+    assert all(type(k) is s2.Plan for k in s2.terms)
+    assert s2.t10() == 10
+
+    # Saving again keeps the same form
+    path2 = tmp_path / "model2"
+    getattr(m2, save_meth)(path2)
+    m2.close()
+    m3 = mx.read_model(path2)
+    assert m3.Space1.Plan is m3.labels.Plan
+    assert m3.Space1.t10() == 10
+
+
+def test_module_class_ref_follows_edited_module(tmp_path, close_new_models):
+    """A copy of the model uses the classes of its own module file."""
+    m = _make_module_class_model(tmp_path)
+    m.write(tmp_path / "model")
+    m.close()
+
+    shutil.copytree(tmp_path / "model", tmp_path / "copy")
+    module_file = tmp_path / "copy" / "labels.py"
+    module_file.write_text(
+        LABELS_SOURCE.replace("T20 = 1", "T20 = 1\n    T30 = 2"),
+        encoding="utf-8")
+
+    m2 = mx.read_model(tmp_path / "copy")
+    assert m2.Space1.Plan is m2.labels.Plan
+    assert m2.Space1.Plan.T30 == 2
+    assert m2.Space1.t10() == 10
+
+
+def test_module_class_ref_missing_class(tmp_path, close_new_models):
+    """A class removed from the module file is lost like other
+    unrestorable pickled values: a warning, and the rest loads."""
+    m = _make_module_class_model(tmp_path)
+    m.write(tmp_path / "model")
+    m.close()
+
+    module_file = tmp_path / "model" / "labels.py"
+    module_file.write_text(
+        LABELS_SOURCE.replace("class Basis:", "class Renamed:"),
+        encoding="utf-8")
+
+    with pytest.warns(UserWarning):
+        m2 = mx.read_model(tmp_path / "model")
+    assert m2.Space1.Plan is m2.labels.Plan
+    assert m2.Space1.t10() == 10
+    assert m2.Space1.Basis is None
+
+
