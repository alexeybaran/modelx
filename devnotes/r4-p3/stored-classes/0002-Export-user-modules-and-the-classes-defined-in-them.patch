diff --git a/modelx/export/_mx_sys.py b/modelx/export/_mx_sys.py
index 98400a4..e590eae 100644
--- a/modelx/export/_mx_sys.py
+++ b/modelx/export/_mx_sys.py
@@ -64,7 +64,7 @@ class BaseModel(BaseParent):
         p = self.path / '_mx_pickled'
         if p.exists():
             with open(p, mode='rb') as f:
-                pickle_data = pickle.load(f)
+                pickle_data = DataUnpickler(f, io_data).load()
         else:
             pickle_data = {}
 
@@ -116,6 +116,20 @@ class BaseSpace(BaseParent):
         return obj
 
 
+class DataUnpickler(pickle.Unpickler):
+    """Unpickle classes defined in user modules from the modules in io_data"""
+
+    def __init__(self, file, io_data):
+        super().__init__(file)
+        self.io_data = io_data
+
+    def persistent_load(self, pid):
+        if pid[0] == "ModuleAttr":
+            _, key, name = pid
+            return getattr(self.io_data[key], name)
+        raise pickle.UnpicklingError("unsupported persistent object")
+
+
 class MiniBaseSharedIO:
 
     def __init__(self, path, load_from, kwargs):
@@ -188,12 +202,33 @@ class MiniPandasData(MiniBaseIOSpec):
             self._value._mx_dataclient = self
 
 
+class MiniModuleIO(MiniBaseSharedIO):
+
+    def load_io(self, root):
+        pass
+
+
+class MiniModuleData(MiniBaseIOSpec):
+
+    def load_value(self):
+        # Same as ModuleIO._load_module in modelx
+        from importlib.machinery import SourceFileLoader
+        from importlib.util import spec_from_loader, module_from_spec
+        loader = SourceFileLoader(
+            "<unnamed module>", path=str(self._io.load_from))
+        module = module_from_spec(spec_from_loader(loader.name, loader))
+        loader.exec_module(module)
+        return module
+
+
 io_types = {
-    'PandasIO': MiniPandasIO
+    'PandasIO': MiniPandasIO,
+    'ModuleIO': MiniModuleIO
 }
 
 
 iospec_types = {
-    'PandasData': MiniPandasData
+    'PandasData': MiniPandasData,
+    'ModuleData': MiniModuleData
 }
 
diff --git a/modelx/export/exporter.py b/modelx/export/exporter.py
index c768a21..a775edd 100644
--- a/modelx/export/exporter.py
+++ b/modelx/export/exporter.py
@@ -35,6 +35,7 @@ from modelx.core.space import BaseSpace, DynamicSpace
 from modelx.core.cells import Cells
 from modelx.serialize.ziputil import write_str_utf8, copy_file
 from modelx.core.util import abs_to_rel_tuple
+from modelx.io.moduleio import module_classes
 
 from . import _mx_sys
 from .transformer import (
@@ -309,8 +310,26 @@ class DataManager:
 
     def pickle(self, path):
         if self.pickle_data:
+            classes = module_classes(self.iospecs.values())
             with open(path, 'wb') as f:
-                pickle.dump(self.pickle_data, f)
+                if classes:
+                    ModuleClassPickler(f, classes).dump(self.pickle_data)
+                else:
+                    pickle.dump(self.pickle_data, f)
+
+
+class ModuleClassPickler(pickle.Pickler):
+    """Pickle classes defined in user modules by the modules' io_data keys"""
+
+    def __init__(self, file, classes):
+        super().__init__(file)
+        self.classes = classes
+
+    def persistent_id(self, obj):
+        if id(obj) in self.classes:
+            spec, name = self.classes[id(obj)]
+            return "ModuleAttr", id(spec.value), name
+        return None
 
 
