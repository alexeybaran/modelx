diff --git a/modelx/export/exporter.py b/modelx/export/exporter.py
index d60bb6f..83ac173 100644
--- a/modelx/export/exporter.py
+++ b/modelx/export/exporter.py
@@ -853,12 +853,20 @@ class SpaceTranslator(ParentTranslator):
 
         return _mx_root
 
-    def {method}(self{other_params}):
+    def _mx_collect_run(self{other_params}):
         return _mx_sys.collect_from_space(
             self, {domain},
             lambda _mx_c: self._mx_collect_item({item_args}),
             ({other_args}), self._mx_collect_cache)
 
+    @property
+    def {method}(self):
+        # Defined on the Space only, as in modelx: not on its ItemSpaces
+        if self._mx_roots:
+            raise AttributeError(
+                "Attribute '{method}' is not in an ItemSpace of " + self._name)
+        return self._mx_collect_run
+
     """)
 
     lock_assign = textwrap.dedent("""\
@@ -1072,7 +1080,7 @@ class SpaceTranslator(ParentTranslator):
                     method = '_mx_collect'   # a member named collect comes first
                 itemspace_dict += '\nself._mx_collect_cache = {}'
                 slot_names.append('_mx_collect_cache')
-                class_names.update(['_mx_collect_item', method])
+                class_names.update(['_mx_collect_item', '_mx_collect_run', method])
                 others = [p for p in space.formula.signature.parameters.values()
                           if p.name != runner.parameter]
                 other_args = ', '.join(p.name for p in others) + (
diff --git a/modelx/tests/export/test_collect_export.py b/modelx/tests/export/test_collect_export.py
index 5d827d7..78ff051 100644
--- a/modelx/tests/export/test_collect_export.py
+++ b/modelx/tests/export/test_collect_export.py
@@ -108,8 +108,23 @@ def test_reference_domain_and_a_member_named_collect(tmp_path, monkeypatch):
     assert e.P.collect().sum.i == 6 == P.collect().sum.i
     assert e.Q.collect == 1 == Q.collect
     assert list(e.Q._mx_collect().individual) == [5] == list(Q._mx_collect().individual)
-    with pytest.raises(TypeError):
-        e.P[2].collect()
+    m.close()
+
+
+def test_itemspaces_have_no_collect_live_or_exported(tmp_path, monkeypatch):
+    m = mx.new_model()
+    P = m.new_space('P', formula=lambda i: None, refs={'keys': (2, 4)})
+    P.set_collect(over={'i': 'keys'}, outputs=lambda: {'sum': {'i': i}})
+    Q = m.new_space('Q', formula=lambda i: None, refs={'keys': (5,), 'collect': 1})
+    Q.set_collect(over={'i': 'keys'}, outputs=lambda: {'individual': {'i': i}})
+    e = export(m, tmp_path, monkeypatch)
+    for space, name in [(P, 'collect'), (e.P, 'collect'),
+                        (Q, '_mx_collect'), (e.Q, '_mx_collect')]:
+        assert hasattr(space, name)
+        item = space[space.keys[0]]
+        assert not hasattr(item, name)
+        with pytest.raises(AttributeError, match="Attribute '%s' is not in" % name):
+            getattr(item, name)
     m.close()
 
 
